{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sezu.local/schema/workspace.schema.json",
  "title": "SEZU Workspace",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "default_target": {"type": "string"},
    "terminals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "browser_profile": {"type": "string"},
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "packs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "environment_remove": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "persistent_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "task_template": {"type": "string"},
    "macros": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
